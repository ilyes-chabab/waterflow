# Copier ce fichier vers .env (gitignore, jamais versionne) et renseigner une
# cle dediee obtenue gratuitement sur https://ocr.space/ocrapi (simple e-mail,
# aucune carte bancaire requise). Sans ce fichier, docker-compose retombe sur
# la cle de demo publique "helloworld" (voir docker-compose.yml).
OCR_SPACE_API_KEY=
